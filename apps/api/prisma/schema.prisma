generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  LOGISTICS_PARTNER
}

enum ProviderType {
  LOCAL_MARKETPLACE
  INTERNATIONAL
}

enum VolumeTier {
  SMALL_UNITS
  MID_QUANTITY
  LARGE_STOCK
}

enum PaymentStatus {
  UNPAID
  PAID
}

enum OrderStatus {
  INTENT_SUBMITTED
  QUOTING
  QUOTED
  QUOTE_SENT
  PAID
  PURCHASED
  RECEIVED_HUB
  CONFIRMED_HUB
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  DECLINED
  UNAVAILABLE
}

enum LogisticsQuoteStatus {
  SUBMITTED
  ACCEPTED
  REVISED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

enum ReservationStatus {
  RESERVED
  CONVERTED
}

model Hub {
  id          String   @id @default(uuid())
  name        String
  city        String
  country     String
  countryCode String
  latitude    Float
  longitude   Float
  timezone    String
  currency    String
  isActive    Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users        User[]
  orders       Order[]
  reservations Reservation[]
}

model User {
  id              String   @id @default(uuid())
  name            String
  email           String   @unique
  phone           String?
  passwordHash    String
  role            Role
  hubId           String?
  hub             Hub?     @relation(fields: [hubId], references: [id])
  detectedCountry String?
  detectedCity    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdOrders   Order[]               @relation("CreatedByUser")
  assignedOrders  Order[]               @relation("AssignedPartner")
  statusChanges   OrderStatusHistory[]
  notifications   Notification[]
  logisticsQuotes LogisticsQuote[]
  reservations    Reservation[]
}

model Provider {
  id              String       @id @default(uuid())
  name            String
  slug            String       @unique
  domains         String[]
  type            ProviderType
  defaultCurrency String
  logoUrl         String?
  isActive        Boolean      @default(true)
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  orders       Order[]
  reservations Reservation[]
}

model Order {
  id         String @id @default(uuid())
  reference  String @unique
  quoteToken String @unique

  hubId String
  hub   Hub    @relation(fields: [hubId], references: [id])

  customerName  String
  customerPhone String
  customerEmail String?

  destinationCity    String
  destinationCountry String

  providerId String?
  provider   Provider? @relation(fields: [providerId], references: [id])

  productName     String
  productUrl      String
  productImageUrl String?
  quantity        Int        @default(1)
  volumeTier      VolumeTier @default(SMALL_UNITS)

  // Admin-visible only (except customerQuoteTotal, which is what the customer sees).
  productCost        Decimal? @db.Decimal(12, 2)
  currency           String?
  logisticsCost      Decimal? @db.Decimal(12, 2)
  platformFee        Decimal? @db.Decimal(12, 2)
  customerQuoteTotal Int?

  paymentStatus PaymentStatus @default(UNPAID)
  paidAt        DateTime?

  notes  String?
  status OrderStatus @default(INTENT_SUBMITTED)

  createdByUserId String
  createdByUser   User   @relation("CreatedByUser", fields: [createdByUserId], references: [id])

  assignedPartnerId String?
  assignedPartner   User?   @relation("AssignedPartner", fields: [assignedPartnerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  history        OrderStatusHistory[]
  notifications  Notification[]
  logisticsQuote LogisticsQuote?
  reservation    Reservation?
}

// One active quote per order — the partner (re)submits into the same row.
model LogisticsQuote {
  id String @id @default(uuid())

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  submittedByUserId String
  submittedByUser   User   @relation(fields: [submittedByUserId], references: [id])

  amount    Decimal              @db.Decimal(12, 2)
  currency  String
  lineItems Json
  note      String?
  status    LogisticsQuoteStatus @default(SUBMITTED)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
}

model OrderStatusHistory {
  id String @id @default(uuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  fromStatus OrderStatus?
  toStatus   OrderStatus

  changedByUserId String
  changedByUser   User   @relation(fields: [changedByUserId], references: [id])

  note      String?
  createdAt DateTime @default(now())
}

// recipientUserId targets a registered User (admin/partner). Customer-facing
// notifications have no User account (see §3 — no customer logins), so they
// go out via recipientEmail/recipientPhone taken from the order instead.
model Notification {
  id String @id @default(uuid())

  recipientUserId String?
  recipientUser   User?   @relation(fields: [recipientUserId], references: [id])
  recipientEmail  String?
  recipientPhone  String?

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  channel NotificationChannel
  title   String
  body    String
  status  NotificationStatus @default(PENDING)

  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@index([recipientUserId, status])
}

// A saved product from search — "I want this for a customer" without yet
// committing to a full intent (customer info, destination). Converts into an
// Order later; kept around either way as a browsable record.
model Reservation {
  id String @id @default(uuid())

  hubId String
  hub   Hub    @relation(fields: [hubId], references: [id])

  reservedByUserId String
  reservedByUser   User   @relation(fields: [reservedByUserId], references: [id])

  providerId String?
  provider   Provider? @relation(fields: [providerId], references: [id])

  externalId String?
  url        String
  title      String?
  imageUrl   String?
  price      Decimal? @db.Decimal(12, 2)
  currency   String?

  status ReservationStatus @default(RESERVED)

  orderId String? @unique
  order   Order?  @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hubId, status])
}
