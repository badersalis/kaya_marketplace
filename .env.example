# API
PORT=4000
NODE_ENV=development
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Database
DATABASE_URL=postgresql://kaya:kaya@localhost:5432/kaya

# Redis
REDIS_URL=redis://localhost:6379

# Link preview / product metadata extraction
LINK_PREVIEW_ENABLED=true
LINK_PREVIEW_TIMEOUT_MS=4000

# Email/SMS providers (default to console logger if unset)
EMAIL_PROVIDER=console        # console | smtp
SMTP_URL=
SMS_PROVIDER=console          # console | <gateway>
SMS_API_KEY=

# Seeds
SEED_SUPERADMIN_EMAIL=admin@kaya.app
SEED_SUPERADMIN_PASSWORD=ChangeMe123!
SEED_PARTNER_EMAIL=partner@kaya.app
SEED_PARTNER_PASSWORD=ChangeMe123!
SEED_DEMO=true

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000
